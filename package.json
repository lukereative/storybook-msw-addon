{
  "name": "storybook-msw-addon",
  "version": "2.1.7",
  "description": "An MSW (Mock Service Worker) addon including a control panel that enables interaction and manipulation of mock requests within Storybook. MSW 2.3.3 + Storybook 8",
  "keywords": [
    "storybook-addons",
    "msw",
    "api",
    "requests",
    "mock",
    "service",
    "worker"
  ],
  "type": "module",
  "packageManager": "pnpm@8.15.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/offbeat-dev/storybook-msw-addon"
  },
  "author": {
    "name": "offbeat-dev",
    "email": "offbeat.it.all@gmail.com"
  },
  "contributors": [
    "offbeat-dev <offbeat.it.all@gmail.com>",
    "AnaVillav <ana.villavicencio.b@gmail.com>"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preview": {
      "types": "./dist/index.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    },
    "./preset": "./dist/preset.cjs",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "clean": "rimraf ./dist",
    "commit": "npm run git-cz",
    "prebuild": "pnpm clean",
    "build": "tsup",
    "build:watch": "pnpm build --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "concurrently \"pnpm build:watch\" \"pnpm storybook --quiet\"",
    "prerelease": "zx scripts/prepublish-checks.mjs",
    "release": "pnpm run build && auto shipit",
    "eject-ts": "zx scripts/eject-typescript.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve-storybook": "npx http-server storybook-static -p 5005",
    "semantic-release": "semantic-release"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.13.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/prompt": "^19.8.1",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/typescript-react-query": "^6.1.1",
    "@parcel/watcher": "^2.5.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@storybook/addon-docs": "^9.0.15",
    "@storybook/addon-links": "9.0.15",
    "@storybook/icons": "^1.4.0",
    "@storybook/react-vite": "9.0.15",
    "@tanstack/react-query": "^5.81.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "auto": "^11.3.0",
    "boxen": "^8.0.1",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.0",
    "dedent": "^1.6.0",
    "graphql": "^16.11.0",
    "husky": "^9.1.7",
    "msw": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "sass": "^1.72.0",
    "semantic-release": "^24.2.6",
    "storybook": "^9.0.15",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "zx": "^8.6.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "exportEntries": [
      "src/index.ts"
    ],
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts"
    ],
    "nodeEntries": []
  },
  "storybook": {
    "displayName": "Mock Service Worker Addon Panel",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ],
    "icon": "https://raw.githubusercontent.com/offbeat-dev/storybook-msw-addon/main/storybook-msw-addon.png"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql-request": "^7.2.0",
    "is-node-process": "^1.2.0"
  }
}
